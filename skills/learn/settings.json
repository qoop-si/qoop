{
  "env": {
    "SLASH_COMMAND_TOOL_CHAR_BUDGET": "3000"
  },
  "bashOutputMaxChars": 15000,
  "disableClaudeAiConnectors": true,
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read", "Glob", "Grep", "TodoWrite",
      "Edit(/@LEARN@/**)", "Edit(/@QASS_CONFIG@/owner.md)", "Edit(/@QASS_DATA@/learn.jsonl)",
      "Bash(qoop history:*)", "Bash(qoop show:*)", "Bash(qoop close:*)", "Bash(date:*)", "Bash(./replay)"
    ],
    "deny": [
      "Edit(/@LEARN@/replay)", "Edit(/@LEARN@/replay.jsonl)",
      "mcp__*", "Agent", "Skill", "Monitor", "WebFetch", "WebSearch", "NotebookEdit", "Artifact", "ArtifactComments",
      "ArtifactData", "Workflow", "CronCreate", "CronDelete", "CronList", "DesignSync", "EnterPlanMode",
      "ExitPlanMode", "EnterWorktree", "ExitWorktree", "PublishPlugin", "PushNotification", "RemoteTrigger",
      "ReportFindings", "ShareOnboardingGuide", "ScheduleWakeup", "AskUserQuestion", "ListAgents", "SendMessage"
    ]
  }
}
