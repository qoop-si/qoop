{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push -f*": "deny",
      "git push --force*": "deny",
      "git push * -f*": "deny",
      "git push *--force*": "deny",
      "git push * main*": "deny",
      "git push * master*": "deny",
      "git push *:main*": "deny",
      "git push *:master*": "deny",
      "gh pr merge*": "deny",
      "gh release*": "deny",
      "git tag*": "deny",
      "npm publish*": "deny",
      "qoro prompt*": "deny",
      "qoro send*": "deny",
      "*.qass*": "deny",
      "*qoro/qass*": "deny"
    },
    "edit": {
      "*": "allow",
      "@QASS_DATA@/**": "deny",
      "@QASS_CONFIG@/**": "deny"
    }
  }
}
