{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(qoro agents*)",
      "Bash(qoro context *)",
      "Bash(qoro read *)",
      "Bash(qoro history *)",
      "Bash(qoro prompt *)",
      "Bash(qoro send *)",
      "Bash(wend search *)",
      "Read(~/.qass/**)",
      "Edit(~/.qass/goals.md)",
      "Edit(~/.qass/lessons.md)"
    ],
    "deny": [
      "Edit(~/.qass/policy)",
      "Edit(~/.qass/gate.jsonl)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.claude/skills/qass/gate.sh\" tool", "timeout": 20 }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "\"$HOME/.claude/skills/qass/gate.sh\" owner" }] }
    ],
    "SessionStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "f=\"$HOME/.qass/lessons.md\"; if [ -s \"$f\" ]; then echo 'Lessons from the owner (~/.qass/lessons.md):'; cat \"$f\"; fi; true" }] }
    ]
  }
}
